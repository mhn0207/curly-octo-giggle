# Required LLM configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=

# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Redis and ChromaDB
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Skills
ZHIYING_SKILLS_DIR=./skills
ZHIYING_SKILLS_MAX_PROMPT_CHARS=5000

# Controlled Agent business tool calling
ZHIYING_AGENT_TOOL_CALLING=true
ZHIYING_AGENT_MAX_TOOL_STEPS=4
ZHIYING_AGENT_REQUEST_TIMEOUT=60

# Structured output (safe default: legacy path)
ZHIYING_LANGCHAIN_STRUCTURED_OUTPUT=false
ZHIYING_STRUCTURED_OUTPUT_MODE=tool
ZHIYING_STRUCTURED_OUTPUT_FALLBACK=true
ZHIYING_STRUCTURED_OUTPUT_SHADOW=false
ZHIYING_STRUCTURED_OUTPUT_VALIDATION_RETRIES=1
ZHIYING_LLM_TIMEOUT=30
ZHIYING_LLM_MAX_RETRIES=2

# LangChain RAG rollout (safe default: legacy path)
ZHIYING_LANGCHAIN_RAG=false
ZHIYING_RAG_ROLLOUT_MODE=legacy
ZHIYING_RAG_CANARY_PERCENT=0
ZHIYING_KB_COLLECTION=knowledge_base_langchain
ZHIYING_EMBEDDING_PROVIDER=chroma_default
ZHIYING_EMBEDDING_MODEL=all-MiniLM-L6-v2
ZHIYING_EMBEDDING_DIMENSIONS=384
ZHIYING_EMBEDDING_CACHE_DIR=./data/chroma/embedding-cache
ZHIYING_RAG_CHUNK_SIZE=500
ZHIYING_RAG_CHUNK_OVERLAP=80
ZHIYING_RAG_MAX_CONCURRENCY=4

# Monitoring and evaluation
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
EVAL_BASELINE_PATH=./data/eval/baseline.json
ZHIYING_PROFILE_SHUTDOWN_TIMEOUT=30

# Frontend / Nginx
VITE_ZHIYING_API_URL=/api/zhiying
ZHIYING_API_UPSTREAM=zhiying:8000
